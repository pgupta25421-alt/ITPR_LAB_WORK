import java.util.Scanner;

public class TriangleCheck {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input three sides
        System.out.print("Enter side 1: ");
        double a = sc.nextDouble();

        System.out.print("Enter side 2: ");
        double b = sc.nextDouble();

        System.out.print("Enter side 3: ");
        double c = sc.nextDouble();

        // Check if valid triangle (Triangle Inequality Rule)
        if (a + b > c && a + c > b && b + c > a) {
            System.out.println("\n✔ The sides form a valid triangle.");

            // Determine type of triangle
            if (a == b && b == c) {
                System.out.println("Triangle Type: Equilateral Triangle");
            } 
            else if (a == b || b == c || a == c) {
                System.out.println("Triangle Type: Isosceles Triangle");
            } 
            else {
                System.out.println("Triangle Type: Scalene Triangle");
            }

            // Check for right-angled triangle
            if (a*a + b*b == c*c || a*a + c*c == b*b || b*b + c*c == a*a) {
                System.out.println("Additionally, it is a Right-Angled Triangle.");
            }

        } else {
            System.out.println("\n✘ The sides do NOT form a valid triangle.");
        }

        sc.close();
    }
}
